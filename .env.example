PORT=8787
HOST=0.0.0.0
MAX_JSON_BODY_SIZE=70mb

# Mobile public API target. Expo bundles EXPO_PUBLIC_* values into app JavaScript.
#
# Local iOS simulator:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
#
# Local Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8787
#
# Physical device on same Wi-Fi as the local API:
# EXPO_PUBLIC_API_BASE_URL=http://<your-LAN-IP>:8787
#
# EAS development and preview/staging builds currently use the HTTPS staging API:
# EXPO_PUBLIC_API_BASE_URL=https://darija-api-staging-nwjxqrn2ra-uc.a.run.app
#
# Production should be configured only after a production API URL exists.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# Optional local debugging only. Leave unset for user-facing builds.
# EXPO_PUBLIC_SHOW_DIAGNOSTICS=true

EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_LEGAL_PRIVACY_URL=https://darija-to-english-legal.pages.dev/privacy
EXPO_PUBLIC_LEGAL_TERMS_URL=https://darija-to-english-legal.pages.dev/terms
EXPO_PUBLIC_LEGAL_DATA_DELETION_URL=https://darija-to-english-legal.pages.dev/data-deletion
EXPO_PUBLIC_LEGAL_AI_DISCLOSURE_URL=https://darija-to-english-legal.pages.dev/ai-processing
EXPO_PUBLIC_SUPPORT_URL=https://darija-to-english-legal.pages.dev/support

# Clerk public mobile config. This publishable key is safe for the app bundle.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key

# Clerk server config. Never expose this value through EXPO_PUBLIC_*.
CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
CLERK_WEBHOOK_SIGNING_SECRET=replace-with-your-clerk-webhook-signing-secret
# Clerk Frontend API URL used by Convex to validate Clerk JWTs.
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api-url.clerk.accounts.dev

# Convex app config. EXPO_PUBLIC_CONVEX_URL is safe for the app bundle.
CONVEX_DEPLOYMENT=dev:jovial-ibis-363
EXPO_PUBLIC_CONVEX_URL=https://jovial-ibis-363.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://jovial-ibis-363.convex.site
CONVEX_URL=https://jovial-ibis-363.convex.cloud
CONVEX_SITE_URL=https://jovial-ibis-363.convex.site
# Server-to-Convex shared secret. Set the same value in Convex env.
CONVEX_SERVER_SECRET=replace-with-random-server-secret

# Server/API-host Darija ASR config. Never expose these values through EXPO_PUBLIC_*.
DARIJA_ASR_BASE_URL=https://your-workspace--transcribe.modal.run
# Reference-compatible alias; either DARIJA_ASR_BASE_URL or DARIJA_ASR_URL works.
DARIJA_ASR_URL=https://your-workspace--transcribe.modal.run
DARIJA_ASR_API_KEY=changeme
DARIJA_ASR_TIMEOUT_MS=900000

# Server-side audio storage. Do not expose these as EXPO_PUBLIC_*.
AUDIO_UPLOAD_MAX_BYTES=50000000
AUDIO_RETENTION_DAYS=30
EPHEMERAL_RESULT_RETENTION_HOURS=24
TERMS_VERSION=2026-06-02
PRIVACY_POLICY_VERSION=2026-06-02
AI_PROCESSING_CONSENT_VERSION=2026-06-02
PROVIDERS_DISCLOSURE_VERSION=2026-06-02
RETENTION_POLICY_VERSION=2026-06-02
# Optional ops-only secret for POST /v1/admin/retention/cleanup.
RETENTION_CLEANUP_SECRET=

# Server/API-host OpenAI config. Never expose this value through EXPO_PUBLIC_*.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CONSOLIDATION_MODEL=gpt-5.5
OPENAI_TRANSLATION_MODEL=gpt-5.5
ENABLE_TTS=false
TTS_PROVIDER=openai
TTS_LANGUAGE=en
TTS_RESPONSE_FORMAT=aac
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar

# First-version outbound reply audio uses OpenAI only. If unset, ENABLE_RESPONSE_TTS
# follows ENABLE_TTS so local `ENABLE_TTS=true` enables both audio paths.
ENABLE_RESPONSE_TTS=false
RESPONSE_TTS_PROVIDER=openai
RESPONSE_TTS_LANGUAGE=ar
RESPONSE_TTS_FORMAT=mp3
OPENAI_RESPONSE_TTS_MODEL=gpt-4o-mini-tts
OPENAI_RESPONSE_TTS_VOICE=cedar

# Trigger.dev server/worker config. Do not expose these as EXPO_PUBLIC_*.
TRIGGER_PROJECT_REF=proj_tehveeweadzwantwpvpr
TRIGGER_SECRET_KEY=replace-with-your-trigger-secret-key
TRIGGER_ENVIRONMENT=dev
