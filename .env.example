PORT=8787
HOST=0.0.0.0
MAX_JSON_BODY_SIZE=70mb

# Use http://10.0.2.2:8787 for Android emulator, http://localhost:8787 for iOS simulator,
# or http://<your-LAN-IP>:8787 for a physical device on the same Wi-Fi.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# Clerk public mobile config. Expo bundles EXPO_PUBLIC_* values into app JavaScript.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key

# Clerk server config. Never expose this value through EXPO_PUBLIC_*.
CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
CLERK_WEBHOOK_SIGNING_SECRET=replace-with-your-clerk-webhook-signing-secret

DARIJA_ASR_BASE_URL=https://your-workspace--transcribe.modal.run
# Reference-compatible alias; either DARIJA_ASR_BASE_URL or DARIJA_ASR_URL works.
DARIJA_ASR_URL=https://your-workspace--transcribe.modal.run
DARIJA_ASR_API_KEY=changeme
DARIJA_ASR_TIMEOUT_MS=900000

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CONSOLIDATION_MODEL=gpt-5.5
OPENAI_TRANSLATION_MODEL=gpt-5.5

# Supabase server config for project ref npjsersrmvltoxmqdkzd.
# These are backend-only values for the local API. Do not add EXPO_PUBLIC_* variants for secrets.
SUPABASE_URL=https://npjsersrmvltoxmqdkzd.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
# Legacy fallback only if a Supabase secret key is not available:
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-legacy-service-role-key
