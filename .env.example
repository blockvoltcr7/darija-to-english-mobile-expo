PORT=8787
HOST=0.0.0.0
MAX_JSON_BODY_SIZE=70mb

# Mobile public API target. Expo bundles EXPO_PUBLIC_* values into app JavaScript.
#
# Local iOS simulator:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
#
# Local Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8787
#
# Physical device on same Wi-Fi as the local API:
# EXPO_PUBLIC_API_BASE_URL=http://<your-LAN-IP>:8787
#
# EAS development and preview/staging builds currently use the HTTPS staging API:
# EXPO_PUBLIC_API_BASE_URL=https://darija-api-staging-nwjxqrn2ra-uc.a.run.app
#
# Production should be configured only after a production API URL exists.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# Clerk public mobile config. This publishable key is safe for the app bundle.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key

# Clerk server config. Never expose this value through EXPO_PUBLIC_*.
CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
CLERK_WEBHOOK_SIGNING_SECRET=replace-with-your-clerk-webhook-signing-secret

# Server/API-host Darija ASR config. Never expose these values through EXPO_PUBLIC_*.
DARIJA_ASR_BASE_URL=https://your-workspace--transcribe.modal.run
# Reference-compatible alias; either DARIJA_ASR_BASE_URL or DARIJA_ASR_URL works.
DARIJA_ASR_URL=https://your-workspace--transcribe.modal.run
DARIJA_ASR_API_KEY=changeme
DARIJA_ASR_TIMEOUT_MS=900000

# Server-side audio storage. Do not expose these as EXPO_PUBLIC_*.
AUDIO_UPLOAD_MAX_BYTES=50000000
AUDIO_RETENTION_DAYS=30

# Server/API-host OpenAI config. Never expose this value through EXPO_PUBLIC_*.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CONSOLIDATION_MODEL=gpt-5.5
OPENAI_TRANSLATION_MODEL=gpt-5.5

# Supabase server config for project ref npjsersrmvltoxmqdkzd.
# These are backend-only values for the local API. Do not add EXPO_PUBLIC_* variants for secrets.
SUPABASE_URL=https://npjsersrmvltoxmqdkzd.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
SUPABASE_AUDIO_ORIGINALS_BUCKET=audio-originals
SUPABASE_TRANSLATION_ARTIFACTS_BUCKET=translation-artifacts
# Legacy fallback only if a Supabase secret key is not available:
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-legacy-service-role-key

# Trigger.dev server/worker config. Do not expose these as EXPO_PUBLIC_*.
TRIGGER_PROJECT_REF=proj_tehveeweadzwantwpvpr
TRIGGER_SECRET_KEY=replace-with-your-trigger-secret-key
TRIGGER_ENVIRONMENT=dev
