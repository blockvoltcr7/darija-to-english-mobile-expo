{
  "expo": {
    "name": "Darija to English",
    "slug": "darija-to-english-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "darijaenglish",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0E1116"
    },
    "ios": {
      "bundleIdentifier": "com.samisabiridrissi.darijatoenglish",
      "appleTeamId": "57JWLP426D",
      "supportsTablet": true
    },
    "android": {
      "package": "com.samisabiridrissi.darijatoenglish",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Darija to English to record audio.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
