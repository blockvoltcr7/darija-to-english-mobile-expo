{
  "expo": {
    "name": "Darija to English",
    "slug": "darija-to-english-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "darijaenglish",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0E1116"
    },
    "ios": {
      "bundleIdentifier": "com.samisabiridrissi.darijatoenglish",
      "appleTeamId": "57JWLP426D",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.samisabiridrissi.darijatoenglish",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Darija to English to record audio for AI-powered translation and reply generation.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70c597ff-6021-4069-bb43-9c301ac4baa2"
      }
    },
    "owner": "blockvoltcr7",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/70c597ff-6021-4069-bb43-9c301ac4baa2"
    }
  }
}
