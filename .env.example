PORT=8787
HOST=0.0.0.0

# Use http://10.0.2.2:8787 for Android emulator, http://localhost:8787 for iOS simulator,
# or http://<your-LAN-IP>:8787 for a physical device on the same Wi-Fi.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

DARIJA_ASR_BASE_URL=https://your-workspace--transcribe.modal.run
# Reference-compatible alias; either DARIJA_ASR_BASE_URL or DARIJA_ASR_URL works.
DARIJA_ASR_URL=https://your-workspace--transcribe.modal.run
DARIJA_ASR_API_KEY=changeme

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CONSOLIDATION_MODEL=gpt-5.5
OPENAI_TRANSLATION_MODEL=gpt-5.5
